DATABRICKS_PROFILE=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=qa
DATABRICKS_WAREHOUSE_ID=
TEST_CASE_TABLE_NAME=test_cases
PAYOR_CONFIG_CATALOG=your_catalog
PAYOR_CONFIG_SCHEMA=your_schema
PAYOR_CONFIG_TABLE_NAME=your_table
VALIDATION_SQL_CATALOG=main
VALIDATION_SQL_SCHEMA=qa
VALIDATION_SQL_TABLE_NAME=validation_sql
TEST_CASE_RESULTS_CATALOG=main
TEST_CASE_RESULTS_SCHEMA=qa
TEST_CASE_RESULTS_TABLE_NAME=test_case_results
GENIE_SPACE_TITLE=Health Check SQL Generator
APP_DEBUG=true
APP_LOG_LEVEL=INFO
APP_CONSOLE_LOG_LEVEL=ERROR
APP_LOG_FILE=logs/data_health_monitor.log
APP_LOG_MAX_BYTES=10485760
APP_LOG_BACKUP_COUNT=5

# Local SQL Server database configuration. Copy these names to .env and replace
# placeholders with local development values. Do not commit .env credentials.
DATABASE_SERVER=localhost
DATABASE_PORT=1433
DATABASE_NAME=data_health_monitor
DATABASE_SCHEMA=dhm
DATABASE_AUTHENTICATION_MODE=sql_password
DATABASE_USERNAME=your_sql_username
DATABASE_PASSWORD=replace_with_local_password
DATABASE_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DATABASE_CONNECTION_TIMEOUT_SECONDS=30
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_ECHO=false
DATABASE_ENCRYPT=true
DATABASE_TRUST_SERVER_CERTIFICATE=false